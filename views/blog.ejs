<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('./Partials/head') %>
    <title>Blogging App</title>
</head>
<body>
    <%- include('./Partials/navbar') %>
    <div class="container mt-3">
        <h1><%= blog.title %></h1>
        <img src="<%= blog.coverImageUrl %>" alt="" width="600px">
        <pre><%= blog.body %></pre>
    </div>
    <div class="container mt-4">
        <img src="<%= blog.createdBy.profilePicUrl %>" alt="" width="50px"><%= blog.createdBy.name %>
    </div>
    
    <div class="container mt-3">
        <h3>Comments (<%= comments.length %>)</h3>
        <% if (locals.user) { %>
                <form action="/blog/comment/<%= blog._id %>" method="post">
        <input
          type="text"
          name="content"
          class="form-control"
          id="exampleInputEmail1"
          aria-describedby="emailHelp"
        />
        <button type="submit" class="btn btn-primary" style="margin: 12px">
          Post
        </button>
    </form>

    <% } %>
    <%  if(!locals.user) { %>
        <h6>Create an Account / SignIn to Comment </h6>
        <% } %>
    <div class="mt-3">
        <% comments.forEach(comment => { %>
           <img src="<%= comment.createdBy.profilePicUrl %>" alt="" width="30px">
           <%= comment.createdBy.name %> <pre><%= comment.content %></pre>
        <% }) %>
    </div>
    <%- include('./Partials/script') %>
</body>
</html>